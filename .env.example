# ==============================================================================
# MODELO DE CONFIGURAÇÃO — Saúde Digital Piraí
#
# Copie este arquivo para ".env" e preencha com os valores reais do ambiente.
# O .env NUNCA é commitado (já está no .gitignore) e no servidor deve ficar
# com permissão restrita:  chmod 600 .env
#
# Gere valores novos (não reaproveite os de outro ambiente) com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   python -c "import secrets,string; a=string.ascii_lowercase+string.digits; print('painel-'+''.join(secrets.choice(a) for _ in range(22))+'/')"
# ==============================================================================


# ------------------------------------------------------------------------------
# DJANGO
# ------------------------------------------------------------------------------

# Chave de assinatura de sessões e tokens CSRF. Trocar esta chave desloga todo
# mundo. Obrigatória em produção.
DJANGO_SECRET_KEY=cole-aqui-uma-chave-gerada

# Domínios que o site aceita responder, separados por vírgula. Obrigatória em produção.
DJANGO_ALLOWED_HOSTS=saude.pirai.rj.gov.br,www.saude.pirai.rj.gov.br

# Origens confiáveis para envio de formulários (com https://). Se ficar vazia,
# é montada automaticamente a partir de DJANGO_ALLOWED_HOSTS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://saude.pirai.rj.gov.br,https://www.saude.pirai.rj.gov.br


# ------------------------------------------------------------------------------
# ROTA DO PAINEL ADMINISTRATIVO
#
# Caminho de acesso ao CMS. Nunca use "admin/". Este valor é o único lugar onde
# o caminho real existe — ele não está no código nem no repositório.
# Obrigatória em produção.
# ------------------------------------------------------------------------------

ADMIN_URL=painel-troque-este-valor/

# Opcional: restringe o painel a IPs/faixas específicos (rede da prefeitura,
# VPN). Vazio = sem restrição por IP. Quem cair fora da lista recebe 404.
# Ex.: ADMIN_IPS_PERMITIDOS=200.150.10.42,10.0.0.0/8
ADMIN_IPS_PERMITIDOS=


# ------------------------------------------------------------------------------
# SUPERUSUÁRIO DO PAINEL
# Lidos pelo comando: python manage.py criar_admin
# ------------------------------------------------------------------------------

DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=defina-uma-senha-forte-aqui
DJANGO_ADMIN_EMAIL=ti@pirai.rj.gov.br


# ------------------------------------------------------------------------------
# BANCO DE DADOS — MySQL
# ------------------------------------------------------------------------------

DB_NAME=saude_pirai
DB_USER=saude_pirai
DB_PASSWORD=senha-do-banco
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Só para desenvolvimento local: use 1 para trabalhar com SQLite em vez de
# subir um MySQL na máquina. Ignorado em produção.
USE_SQLITE=0


# ------------------------------------------------------------------------------
# HTTPS
# ------------------------------------------------------------------------------

# 1 quando o Django roda atrás de nginx/Traefik/Cloudflare (o normal).
# Só ligue se o proxy realmente define X-Forwarded-Proto.
DJANGO_ATRAS_DE_PROXY=1

# 1 para o Django redirecionar HTTP -> HTTPS. Deixe 0 se o proxy já faz isso.
DJANGO_SSL_REDIRECT=1

# HSTS em segundos. Comece com 3600 e só suba para 31536000 (1 ano) depois de
# confirmar que o certificado está estável — HSTS não tem volta rápida.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMINIOS=1
DJANGO_HSTS_PRELOAD=0


# ------------------------------------------------------------------------------
# SESSÃO E LOGS
# ------------------------------------------------------------------------------

# Duração da sessão do painel, em segundos (28800 = 8 horas).
SESSION_COOKIE_AGE=28800

DJANGO_LOG_LEVEL=INFO

# Opcional: pasta para gravar django.log com rotação. Vazio = só stdout/stderr.
LOG_DIR=


# ------------------------------------------------------------------------------
# E-MAIL (opcional) — envia relatório de erro 500 para os administradores
# ------------------------------------------------------------------------------

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
DJANGO_ADMIN_EMAILS=
